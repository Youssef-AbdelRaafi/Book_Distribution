# Copy this file to .env before the first Docker startup.
# Do not commit the .env file or reuse these values between installations.

# Required: generate a unique 48-byte Base64 value. See DEPLOYMENT.md.
JWT_SIGNING_KEY=

# Required for the first production startup: run
# .\BookDistributionAPI\scripts\generate-admin-password-hash.ps1
# and paste its Compose-ready output here.
ADMIN_PASSWORD_HASH=

# Set to false only when scheduled backups are intentionally disabled.
BACKUP_ENABLED=true
